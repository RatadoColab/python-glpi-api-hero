# GLPI connection (required by the consumer)
GLPI_URL=https://glpi.example.com/apirest.php
GLPI_APPTOKEN=
GLPI_USER=
GLPI_PASSWD=
GLPI_ENTITIES_ID=0
GLPI_PROFILES_ID=4

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
# Optional topology names (defaults shown)
# RABBITMQ_EXCHANGE=glpi.locations
# RABBITMQ_ROUTING_KEY=locations.update
# RABBITMQ_QUEUE=locations.update

# Throttling and retry (rate limit handling)
GLPI_REQUEST_DELAY=0.5
GLPI_RETRY_DELAY_MS=30000

# Record handling
# Mapper converting each record into GLPI Location fields ("package.module:function").
# Leave empty when records already use GLPI field names.
ITEM_MAPPER=org_units.mapper:map_org_unit
# Field of the record used to label log lines
ITEM_LABEL_FIELD=NOME
# GLPI field used to match existing locations
LOCATION_KEY_FIELD=code
# JSON file read by the producer (list of records)
SOURCE_JSON=data.json
