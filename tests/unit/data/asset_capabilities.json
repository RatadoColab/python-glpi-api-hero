 "excluded": {
  "Appliance": {
   "capabilities": [
    "appliance"
   ],
   "reason": "Appliance_Item has appliances_id: GLPI filters the sub-item by the parent as owner, so it would list the items of the appliance, not the appliances it belongs to"
  },
  "Document": {
   "capabilities": [
    "document"
   ],
   "reason": "Document_Item has documents_id: same ambiguity (Document.get_items lists the items of the document)"
  },
  "Supplier": {
   "capabilities": [
    "contract"
   ],
   "reason": "Supplier.get_contracts is its own method (Contract_Supplier); Supplier is not in contract_types"
  }
 },
